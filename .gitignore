node_modules/
dist/
dist-electron/
apps/*/dist/
apps/*/web/dist/

# Local runtime + workspace state (machine-specific)
# Anchored to repo root so we don't accidentally ignore src/workspace/, etc.
/runtime/
/workspace/
/data/
.inno/
.pi/

# Logs and editor noise
*.log
.DS_Store
.env
.idea/
.vscode/

# Python bytecode caches (generated locally, never source artifacts)
__pycache__/
*.py[cod]

# Local agent / tooling outputs
graphify-out/
.claude/

# Icon build intermediates (keep icon.svg/icns/png)
build/icon.iconset/

# Docs (local only)
apps/inno-agent/docs/
.zcode/
# 本地运行文件，不上传
/tmp/
/work/

# Python 运行与测试缓存，不上传
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
htmlcov/

